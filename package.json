    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "electron-store": "^8.2.0",
    "js-yaml": "^5.5.0",
    "lexical": "^0.52.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
