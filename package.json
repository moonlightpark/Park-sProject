{
  "name": "nimbalyst-ko",
  "productName": "박프로",
  "version": "0.1.0",
  "private": true,
  "description": "AI 에이전트와 함께 쓰는 한국어 마크다운 작업공간",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "electron-builder install-app-deps && node -e \"for(const a of ['arm64','x64'])try{require('fs').chmodSync('node_modules/node-pty/prebuilds/darwin-'+a+'/spawn-helper',0o755)}catch{}\"",
    "dist": "electron-vite build && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@lexical/code": "^0.52.0",
    "@lexical/code-prism": "^0.52.0",
